[
  {
    "label": "cargo check",
    "command": "cargo",
    "args": ["check", "--all-targets"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never"
  },
  {
    "label": "cargo test current file",
    "command": "cargo",
    "args": ["test", "--", "$ZED_STEM"],
    "tags": ["rust-test"]
  },
  {
    "label": "cargo run",
    "command": "cargo",
    "args": ["run"],
    "use_new_terminal": false,
    "reveal": "always"
  },
  {
    "label": "inspect active file",
    "command": "echo",
    "args": ["Inspecting active file:", "$ZED_FILE", "in worktree:", "$ZED_WORKTREE_ROOT"],
    "reveal": "always"
  }
]
